# ── Database ────────────────────────────────────────────────────────────────
# Railway provisions these. Locally, `pnpm bootstrap` starts Postgres in Docker.
DATABASE_URL="postgresql://stud:stud@localhost:5438/stud?schema=public"
# Direct (non-pooled) connection — required for migrations behind a pooler.
DIRECT_URL="postgresql://stud:stud@localhost:5438/stud?schema=public"
SHADOW_DATABASE_URL="postgresql://stud:stud@localhost:5438/stud_shadow?schema=public"

# ── API ─────────────────────────────────────────────────────────────────────
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
# openssl rand -base64 32
AUTH_SECRET="change-me-openssl-rand-base64-32"
SESSION_TTL_DAYS=30
CORS_ORIGINS="http://localhost:3000,http://localhost:3001"
# COOKIE_DOMAIN=".stud.dog"

# ── Web surfaces ────────────────────────────────────────────────────────────
# Ports for the two Next.js surfaces. `pnpm bootstrap` rewrites all of these
# to whatever is actually free on this machine.
WEB_PORT=3000
STUDIO_PORT=3001

NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_STUDIO_URL="http://localhost:3001"

# ── Verification (Phase 2) ──────────────────────────────────────────────────
# Live source adapters are off by default; the fixture adapter serves local dev.
VERIFY_LIVE_SOURCES=false
VERIFY_USER_AGENT="StudVerify/0.1 (+https://stud.dog/verification)"
VERIFY_REQUEST_TIMEOUT_MS=8000
VERIFY_FRESHNESS_DAYS=30

# ── Reconciliation worker (Phase 2) ─────────────────────────────────────────
INGEST_INTERVAL_MS=900000
# Dogs re-verified per pass. Small on purpose — politeness over throughput.
INGEST_BATCH_SIZE=25

# ── Payments (Phase 7) ──────────────────────────────────────────────────────
# Live animal sales are high-risk. Do not enable without written processor
# approval for this vertical. See docs/payments-diligence.md.
PAYMENTS_PROVIDER="mock"
PAYMENTS_SECRET_KEY=""
PAYMENTS_WEBHOOK_SECRET=""
PLATFORM_FEE_BPS=600

{
  "name": "stud",
  "private": true,
  "version": "0.1.0",
  "description": "Stud \u2014 verified dog breeding marketplace and breeder workspace",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "pnpm --filter @stud/db generate",
    "db:migrate": "pnpm --filter @stud/db migrate",
    "db:push": "pnpm --filter @stud/db push",
    "db:seed": "pnpm --filter @stud/db seed",
    "db:studio": "pnpm --filter @stud/db studio",
    "db:reset": "pnpm --filter @stud/db reset",
    "bootstrap": "bash scripts/bootstrap.sh",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "build:api": "pnpm --filter @stud/db generate",
    "start:api": "pnpm --filter @stud/db migrate:deploy:ci && pnpm --filter @stud/api exec tsx src/server.ts",
    "build:web": "find apps/web/.next -mindepth 1 -maxdepth 1 ! -name cache -exec rm -rf {} + 2>/dev/null || true; rm -rf apps/web/.next/cache/* 2>/dev/null || true; turbo run build --filter=@stud/web... --force",
    "start:web": "pnpm --filter @stud/web start:prod",
    "db:import-test-data": "pnpm --filter @stud/db import:test-data",
    "dev:stop": "node scripts/dev-stop.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "eslint": "^9.17.0",
    "typescript-eslint": "^8.18.1",
    "@eslint/js": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "@next/eslint-plugin-next": "^15.1.3",
    "globals": "^15.14.0",
    "railway": "^3.1.1"
  },
  "type": "module"
}

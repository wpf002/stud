// Stud — Prisma schema
//
// Invariants (locked in Phase 0, see README §Architecture):
//   1. Money is ALWAYS integer cents. Never Float, never Decimal-as-dollars.
//   2. Verification is a state machine, never a boolean.
//   3. A dog record is append-only. Corrections supersede, they do not overwrite.
//   4. Self-reported and verified data never share a field.
//
// Sections are appended per phase. Do not reorder.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pg_trgm]
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 0 — Identity, kennels, dogs, registrations
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  OWNER
  BREEDER
  BUYER
  ADMIN
}

enum MembershipRole {
  KENNEL_OWNER
  MANAGER
  HANDLER
  VIEWER
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.Citext
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  bio           String?

  // Location — used for distance search across every surface.
  city      String?
  region    String? // state / province
  country   String  @default("US")
  postalCode String?
  latitude  Float?
  longitude Float?

  // A user can hold several roles at once: an owner of a stud who also buys.
  roles Role[] @default([BUYER])

  timezone String  @default("America/Chicago")
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastSeenAt DateTime?

  accounts      Account[]
  sessions      Session[]
  memberships   Membership[]
  ownedDogs     DogOwnership[]
  auditEntries  AuditLog[]
  pedigreeImports PedigreeImport[]
  reportedClaims  ReportedClaim[]
  documentsReviewed  DocumentSubmission[] @relation("DocumentReviewer")
  documentsSubmitted DocumentSubmission[] @relation("DocumentSubmitter")

  @@index([country, region, city])
  @@index([createdAt])
  @@map("users")
}

/// OAuth / external identity link. One row per provider account.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "google" | "apple" | "facebook"
  providerAccountId String
  type              String  @default("oauth")
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens: email verification, password reset, invite acceptance.
model VerificationToken {
  id        String   @id @default(cuid())
  identifier String
  token     String   @unique
  purpose   String // "email_verify" | "password_reset" | "kennel_invite"
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([identifier, purpose])
  @@map("verification_tokens")
}

/// A breeding program. Dogs, litters, contracts and payouts all hang off this.
model Kennel {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  prefix   String? // registered kennel prefix, e.g. "Blackwater"
  tagline  String?
  about    String? @db.Text
  logoUrl  String?
  coverUrl String?
  websiteUrl String?

  city       String?
  region     String?
  country    String  @default("US")
  postalCode String?
  latitude   Float?
  longitude  Float?

  /// Primary breeds this program works in. Denormalised for search.
  breeds String[] @default([])

  foundedYear Int?
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  dogs        Dog[]

  @@index([country, region])
  @@index([isPublished])
  @@map("kennels")
}

model Membership {
  id       String         @id @default(cuid())
  userId   String
  kennelId String
  role     MembershipRole @default(KENNEL_OWNER)

  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kennel Kennel @relation(fields: [kennelId], references: [id], onDelete: Cascade)

  @@unique([userId, kennelId])
  @@index([kennelId])
  @@map("memberships")
}

/// The dog. Identity only — everything claimed *about* a dog that could be
/// verified lives in a separate table with its own provenance (Phase 2).
model Dog {
  id   String @id @default(cuid())
  slug String @unique

  callName     String // "Ranger"
  registeredName String? // "Blackwater's Ranger Of The Marsh"
  breed        String
  secondaryBreed String? // for documented crosses
  sex          Sex
  dateOfBirth  DateTime?
  dateOfDeath  DateTime?

  colorPattern String?
  markings     String?
  coatType     String?
  heightCm     Float?
  weightKg     Float?

  microchip      String?
  microchipIssuer String?
  dnaProfileId   String? // e.g. AKC DNA profile

  // ── Ancestry (Phase 1) ──────────────────────────────────────────────────
  // The DAG. One sire, one dam, both nullable — biology's own constraint,
  // enforced by the schema rather than by application code.
  sireId String?
  damId  String?

  /// True for ancestor records created by a pedigree import that exist only
  /// as a name on someone else's papers. They still occupy real slots in the
  /// graph; they just have nobody maintaining them.
  isAncestorStub Boolean @default(false)

  /// Set when this record has been merged into another (invariant 4). The
  /// row survives so existing links keep resolving.
  supersededByDogId String?

  /// Self-reported free text. NEVER merged with verified data (invariant 4).
  temperamentNotes String? @db.Text
  ownerNotes       String? @db.Text

  /// Denormalised kennel of record. Ownership history is in DogOwnership.
  kennelId String?

  isDeceased    Boolean @default(false)
  isRetired     Boolean @default(false)
  isPublished   Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kennel        Kennel?        @relation(fields: [kennelId], references: [id], onDelete: SetNull)
  registrations Registration[]
  ownerships    DogOwnership[]
  media         DogMedia[]

  // Ancestry self-relations. SetNull on delete so removing a dog leaves an
  // honest gap in its descendants' pedigrees rather than cascading them away.
  sire         Dog?  @relation("DogSire", fields: [sireId], references: [id], onDelete: SetNull)
  damRel       Dog?  @relation("DogDam", fields: [damId], references: [id], onDelete: SetNull)
  sireOffspring Dog[] @relation("DogSire")
  damOffspring  Dog[] @relation("DogDam")

  supersededBy Dog?  @relation("DogSupersededBy", fields: [supersededByDogId], references: [id], onDelete: SetNull)
  supersedes   Dog[] @relation("DogSupersededBy")

  pedigreeStats     DogPedigreeStats?
  pedigreeImports   PedigreeImport[]    @relation("PedigreeImportRoot")
  mergeCandidatesA  DogMergeCandidate[] @relation("MergeCandidateA")
  mergeCandidatesB  DogMergeCandidate[] @relation("MergeCandidateB")
  supersessionAsOld DogSupersession?    @relation("SupersededDog")
  supersessionAsNew DogSupersession[]   @relation("SurvivingDog")

  // Phase 2 — verification
  verifiedClaims      VerifiedClaim[]
  reportedClaims      ReportedClaim[]
  verificationChecks  VerificationCheck[]
  documentSubmissions DocumentSubmission[]
  verificationSummary DogVerificationSummary?

  @@index([breed, sex])
  @@index([kennelId])
  @@index([isPublished, breed])
  @@index([microchip])
  @@index([sireId])
  @@index([damId])
  @@index([registeredName])
  @@index([supersededByDogId])
  @@map("dogs")
}

enum RegistryBody {
  AKC
  UKC
  CKC // Canadian Kennel Club
  FCI
  KC // The Kennel Club (UK)
  NAVHDA
  AFTCA
  ABCA
  JRTCA
  CONTINENTAL
  OTHER
}

/// A dog's registration with a registry body. A dog may hold several.
model Registration {
  id       String       @id @default(cuid())
  dogId    String
  body     RegistryBody
  number   String
  /// Registered name as it appears on the papers — may differ from Dog.registeredName.
  nameOnRecord String?
  issuedAt DateTime?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([body, number])
  @@index([dogId])
  @@map("registrations")
}

/// Append-only ownership ledger. Transfers (Phase 8) close one row and open
/// the next; rows are never deleted.
model DogOwnership {
  id     String @id @default(cuid())
  dogId  String
  userId String

  /// Co-ownership is common and contractually significant.
  sharePercent Int      @default(100)
  startedAt    DateTime @default(now())
  endedAt      DateTime?
  reason       String? // "purchase" | "transfer" | "co_ownership" | "initial"

  createdAt DateTime @default(now())

  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dogId, endedAt])
  @@index([userId, endedAt])
  @@map("dog_ownerships")
}

enum MediaKind {
  PHOTO
  VIDEO
  DOCUMENT
}

model DogMedia {
  id      String    @id @default(cuid())
  dogId   String
  kind    MediaKind @default(PHOTO)
  url     String
  thumbUrl String?
  caption String?
  width   Int?
  height  Int?
  durationSeconds Int?
  position Int      @default(0)
  isPrimary Boolean @default(false)

  takenAt   DateTime?
  createdAt DateTime  @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, position])
  @@map("dog_media")
}

/// Every consequential mutation lands here. Auditable over impressive.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String   @default("user") // "user" | "system" | "worker"
  action     String // "dog.create" | "verification.transition" | ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1 — Ancestry graph, pedigree import, duplicate resolution
// ═══════════════════════════════════════════════════════════════════════════

// Ancestry is modelled as self-relations on Dog, not an edge table.
//
// Biology gives every dog exactly one sire and one dam, so a pair of nullable
// self-references IS the proper DAG here — indexable, join-free, and
// impossible to represent inconsistently. An edge table would let a dog carry
// three sires. Cycles are rejected at write time (see @stud/pedigree's
// buildGraph and the API's assertNoCycle).

enum PedigreeSourceKind {
  MANUAL
  CSV
  REGISTRY_TEXT
  REGISTRY_API
  MERGE
}

/// Records how a dog's ancestry got here. Provenance matters as much for
/// pedigree as it does for health results — a hand-typed great-grandsire and
/// one pulled from a registry are not the same quality of fact.
model PedigreeImport {
  id       String             @id @default(cuid())
  kennelId String?
  userId   String?
  rootDogId String?

  kind      PedigreeSourceKind
  /// Original pasted text or file name. Kept so an import can be re-run when
  /// the parser improves.
  rawInput  String?            @db.Text
  fileName  String?

  dogsCreated  Int @default(0)
  dogsLinked   Int @default(0)
  dogsSkipped  Int @default(0)
  /// Parser warnings and errors, verbatim.
  issues       Json?

  createdAt DateTime @default(now())

  rootDog Dog?  @relation("PedigreeImportRoot", fields: [rootDogId], references: [id], onDelete: SetNull)
  user    User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kennelId, createdAt])
  @@index([rootDogId])
  @@map("pedigree_imports")
}

enum MergeStatus {
  OPEN
  MERGED
  DISMISSED
}

/// A suspected duplicate pair, surfaced by @stud/pedigree's findDuplicates.
///
/// A duplicated ancestor silently LOWERS every COI it appears in — the two
/// copies read as unrelated dogs. This queue exists because that failure is
/// invisible unless something goes looking for it.
model DogMergeCandidate {
  id        String      @id @default(cuid())
  /// Ordered so (a,b) and (b,a) can never both exist.
  dogAId    String
  dogBId    String
  score     Float
  confidence String     // "certain" | "likely" | "possible"
  reasons   String[]    @default([])
  conflicts String[]    @default([])
  status    MergeStatus @default(OPEN)

  resolvedByUserId String?
  resolvedAt       DateTime?
  /// Which record survived, when status is MERGED.
  keptDogId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dogA Dog @relation("MergeCandidateA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB Dog @relation("MergeCandidateB", fields: [dogBId], references: [id], onDelete: Cascade)

  @@unique([dogAId, dogBId])
  @@index([status, score])
  @@map("dog_merge_candidates")
}

/// Append-only supersession pointer (invariant 4). When two records merge,
/// the losing record is not deleted — it is marked as superseded so any link
/// anyone already holds still resolves.
model DogSupersession {
  id             String   @id @default(cuid())
  supersededDogId String  @unique
  survivingDogId String
  reason         String   @default("merge")
  actorUserId    String?
  createdAt      DateTime @default(now())

  supersededDog Dog @relation("SupersededDog", fields: [supersededDogId], references: [id], onDelete: Cascade)
  survivingDog  Dog @relation("SurvivingDog", fields: [survivingDogId], references: [id], onDelete: Cascade)

  @@index([survivingDogId])
  @@map("dog_supersessions")
}

/// Cached COI so list views and search filters do not recompute a graph walk
/// per row. Always recomputed, never authored — a stale value here is a
/// correctness bug, so `computedAt` and `generations` are mandatory context.
model DogPedigreeStats {
  dogId               String   @id
  /// Wright's F over `generations`.
  coi                 Float
  generations         Int
  /// Maignel's complete generation equivalent.
  generationEquivalent Float
  completenessRatio   Float
  distinctAncestors   Int
  knownSlots          Int
  deepestGeneration   Int
  computedAt          DateTime @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([coi])
  @@index([computedAt])
  @@map("dog_pedigree_stats")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 — Verification engine
// ═══════════════════════════════════════════════════════════════════════════
//
// Invariant 5 is enforced structurally here: VerifiedClaim and ReportedClaim
// are SEPARATE TABLES. There is no column a self-attested value could occupy
// on a verified record, and no fallback path from one to the other. The only
// way into VerifiedClaim is a source lookup.

enum VerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
  STALE
  CONFLICTED
}

enum VerificationSource {
  OFA
  AKC
  UKC
  CKC
  NAVHDA
  AFTCA
  PENNHIP
  EMBARK
  WISDOM
  UC_DAVIS
  PAW_PRINT
  DOCUMENT
  FIXTURE
}

enum ClaimOutcome {
  NORMAL
  CARRIER
  AT_RISK
  ABNORMAL
  INCONCLUSIVE
  INFORMATIONAL
}

enum ClaimCategory {
  HEALTH
  GENETIC
  TITLE
  REGISTRATION
  PERFORMANCE
}

/// A claim confirmed against the body that issued it.
///
/// Nothing writes here except the verification engine. `rawResult` is the
/// source's own wording, retained verbatim; `outcome` is our normalised
/// reading of it and exists only so buyers can filter comparably.
model VerifiedClaim {
  id    String @id @default(cuid())
  dogId String

  /// Matches @stud/verify's ClaimType. Kept as a string rather than an enum so
  /// a new breed panel does not require a migration.
  claimType String
  category  ClaimCategory
  /// For DNA_MARKER: which gene or variant. Empty string, never NULL —
  /// Postgres treats NULLs as distinct in a unique index, so a nullable
  /// column here would silently permit duplicate claims for the same dog.
  markerName String @default("")

  state   VerificationState @default(UNVERIFIED)
  source  VerificationSource
  outcome ClaimOutcome?

  /// Verbatim, as the source phrases it. Never normalised in place.
  rawResult String?
  /// The source's own identifier for this record.
  sourceRecordId String?
  sourceUrl      String?
  /// Anything the source published that does not fit the shape above.
  detail String?

  /// When the test was performed or the title awarded.
  testedAt DateTime?
  /// When a machine last successfully confirmed it.
  lastCheckedAt DateTime?
  /// When it next falls out of the freshness window.
  staleAfter DateTime?
  /// The identifier the lookup matched on.
  matchedIdentifier String?

  /// Populated only while CONFLICTED — what the source now says.
  conflictRawResult String?
  conflictOutcome   ClaimOutcome?
  conflictNote      String?       @db.Text
  conflictedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog    Dog                @relation(fields: [dogId], references: [id], onDelete: Cascade)
  checks VerificationCheck[]
  events VerificationEvent[]

  /// One verified claim per dog per claim per marker per source.
  @@unique([dogId, claimType, markerName, source])
  @@index([dogId, state])
  @@index([state, staleAfter])
  @@index([claimType, outcome])
  @@map("verified_claims")
}

/// A claim the owner made about their own dog.
///
/// Deliberately a different table with a different shape. It has no `source`,
/// no `outcome` and no path to VERIFIED — the only way a claim becomes
/// verified is a fresh lookup that creates a VerifiedClaim of its own.
model ReportedClaim {
  id    String @id @default(cuid())
  dogId String

  claimType  String
  category   ClaimCategory
  /// Empty string, never NULL — see the note on VerifiedClaim.markerName.
  markerName String @default("")

  /// Exactly what the owner typed. Never normalised, never graded.
  statedResult String
  statedTestedAt DateTime?
  note         String? @db.Text

  /// Who said it, so the claim is attributable.
  reportedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dog          Dog   @relation(fields: [dogId], references: [id], onDelete: Cascade)
  reportedBy   User? @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)

  @@unique([dogId, claimType, markerName])
  @@index([dogId])
  @@map("reported_claims")
}

enum LookupStatus {
  FOUND
  NOT_FOUND
  UNAVAILABLE
  DISABLED
  UNSUPPORTED_IDENTIFIER
}

/// Every lookup we ever ran, successful or not.
///
/// This is the receipt drawer. A verified badge without a check row behind it
/// is a bug, and an UNAVAILABLE row is as important as a FOUND one — it is the
/// evidence that we asked and could not get an answer.
model VerificationCheck {
  id      String @id @default(cuid())
  dogId   String
  claimId String?

  source     VerificationSource
  identifier String
  status     LookupStatus
  findingCount Int   @default(0)
  durationMs   Int
  error        String? @db.Text
  /// Raw payload, so a parser fix can be replayed without re-querying.
  raw          Json?

  /// "user" | "system" | "worker"
  actorType   String  @default("user")
  actorUserId String?

  createdAt DateTime @default(now())

  dog   Dog            @relation(fields: [dogId], references: [id], onDelete: Cascade)
  claim VerifiedClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([dogId, createdAt])
  @@index([source, status, createdAt])
  @@map("verification_checks")
}

/// Every state transition, with the reason in the source's own words.
model VerificationEvent {
  id      String @id @default(cuid())
  claimId String

  fromState VerificationState
  toState   VerificationState
  trigger   String
  reason    String  @db.Text
  source    VerificationSource?

  previousRawResult String?
  observedRawResult String?

  actorType   String  @default("system")
  actorUserId String?

  createdAt DateTime @default(now())

  claim VerifiedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("verification_events")
}

enum DocumentReviewStatus {
  QUEUED
  IN_REVIEW
  APPROVED
  REJECTED
}

/// An uploaded certificate awaiting human review.
///
/// OCR pre-fills; a person confirms. Nothing here reaches VerifiedClaim until
/// `reviewedByUserId` is set — an OCR mis-read that turned "Carrier" into
/// "Clear" and auto-published would be the exact failure this platform exists
/// to prevent.
model DocumentSubmission {
  id    String @id @default(cuid())
  dogId String

  /// EMBARK | WISDOM | UC_DAVIS | PAW_PRINT | OTHER
  lab         String
  documentUrl String
  fileName    String?
  mimeType    String?
  fileSize    Int?

  status DocumentReviewStatus @default(QUEUED)

  /// What OCR proposed, with per-suggestion confidence and source lines.
  ocrText        String? @db.Text
  ocrSuggestions Json?

  /// What the reviewer confirmed. Only this becomes verified.
  reviewedFindings Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?  @db.Text

  submittedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dog        Dog   @relation(fields: [dogId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  submittedBy User? @relation("DocumentSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([dogId])
  @@map("document_submissions")
}

/// Denormalised verification density for a dog.
///
/// Drives the badge summary, marketplace filters and breeder tiering (Phase 9).
/// Recomputed, never authored.
model DogVerificationSummary {
  dogId String @id

  verifiedCount   Int @default(0)
  reportedCount   Int @default(0)
  unverifiedCount Int @default(0)
  staleCount      Int @default(0)
  conflictedCount Int @default(0)

  /// Verified health claims with a NORMAL outcome.
  healthNormalCount Int @default(0)
  /// Verified claims with an AT_RISK or ABNORMAL outcome. Never hidden.
  concerningCount   Int @default(0)
  verifiedTitleCount Int @default(0)
  hasChic           Boolean @default(false)

  /// verified ÷ (verified + reported + unverified). The tiering input.
  density Float @default(0)

  computedAt DateTime @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([density])
  @@index([healthNormalCount])
  @@map("dog_verification_summaries")
}

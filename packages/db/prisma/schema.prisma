// Stud — Prisma schema
//
// Invariants (locked in Phase 0, see README §Architecture):
//   1. Money is ALWAYS integer cents. Never Float, never Decimal-as-dollars.
//   2. Verification is a state machine, never a boolean.
//   3. A dog record is append-only. Corrections supersede, they do not overwrite.
//   4. Self-reported and verified data never share a field.
//
// Sections are appended per phase. Do not reorder.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [citext, pg_trgm]
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 0 — Identity, kennels, dogs, registrations
// ═══════════════════════════════════════════════════════════════════════════

enum Role {
  OWNER
  BREEDER
  BUYER
  ADMIN
}

enum MembershipRole {
  KENNEL_OWNER
  MANAGER
  HANDLER
  VIEWER
}

enum Sex {
  MALE
  FEMALE
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique @db.Citext
  emailVerified DateTime?
  passwordHash  String?
  name          String?
  displayName   String?
  avatarUrl     String?
  phone         String?
  bio           String?

  // Location — used for distance search across every surface.
  city       String?
  region     String? // state / province
  country    String  @default("US")
  postalCode String?
  latitude   Float?
  longitude  Float?

  // A user can hold several roles at once: an owner of a stud who also buys.
  roles Role[] @default([BUYER])

  timezone String  @default("America/Chicago")
  isActive Boolean @default(true)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  lastSeenAt DateTime?

  accounts           Account[]
  sessions           Session[]
  memberships        Membership[]
  ownedDogs          DogOwnership[]
  auditEntries       AuditLog[]
  pedigreeImports    PedigreeImport[]
  reportedClaims     ReportedClaim[]
  documentsReviewed  DocumentSubmission[] @relation("DocumentReviewer")
  documentsSubmitted DocumentSubmission[] @relation("DocumentSubmitter")
  studInquiries      StudInquiry[]
  litterInquiries    LitterInquiry[]
  savedPairings      SavedPairing[]
  contractParties    ContractParty[]
  contractSignatures ContractSignature[]

  @@index([country, region, city])
  @@index([createdAt])
  @@map("users")
}

/// OAuth / external identity link. One row per provider account.
model Account {
  id                String  @id @default(cuid())
  userId            String
  provider          String // "google" | "apple" | "facebook"
  providerAccountId String
  type              String  @default("oauth")
  refreshToken      String? @db.Text
  accessToken       String? @db.Text
  expiresAt         Int?
  tokenType         String?
  scope             String?
  idToken           String? @db.Text

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  expiresAt    DateTime
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// Single-use tokens: email verification, password reset, invite acceptance.
model VerificationToken {
  id         String    @id @default(cuid())
  identifier String
  token      String    @unique
  purpose    String // "email_verify" | "password_reset" | "kennel_invite"
  payload    Json?
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([identifier, purpose])
  @@map("verification_tokens")
}

/// A breeding program. Dogs, litters, contracts and payouts all hang off this.
model Kennel {
  id         String  @id @default(cuid())
  slug       String  @unique
  name       String
  prefix     String? // registered kennel prefix, e.g. "Blackwater"
  tagline    String?
  about      String? @db.Text
  logoUrl    String?
  coverUrl   String?
  websiteUrl String?

  city       String?
  region     String?
  country    String  @default("US")
  postalCode String?
  latitude   Float?
  longitude  Float?

  /// Primary breeds this program works in. Denormalised for search.
  breeds String[] @default([])

  foundedYear Int?
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships Membership[]
  dogs        Dog[]

  @@index([country, region])
  @@index([isPublished])
  @@map("kennels")
}

model Membership {
  id       String         @id @default(cuid())
  userId   String
  kennelId String
  role     MembershipRole @default(KENNEL_OWNER)

  invitedByUserId String?
  acceptedAt      DateTime?
  createdAt       DateTime  @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  kennel Kennel @relation(fields: [kennelId], references: [id], onDelete: Cascade)

  @@unique([userId, kennelId])
  @@index([kennelId])
  @@map("memberships")
}

/// The dog. Identity only — everything claimed *about* a dog that could be
/// verified lives in a separate table with its own provenance (Phase 2).
model Dog {
  id   String @id @default(cuid())
  slug String @unique

  callName       String // "Ranger"
  registeredName String? // "Blackwater's Ranger Of The Marsh"
  breed          String
  secondaryBreed String? // for documented crosses
  sex            Sex
  dateOfBirth    DateTime?
  dateOfDeath    DateTime?

  colorPattern String?
  markings     String?
  coatType     String?
  heightCm     Float?
  weightKg     Float?

  microchip       String?
  microchipIssuer String?
  dnaProfileId    String? // e.g. AKC DNA profile

  // ── Ancestry (Phase 1) ──────────────────────────────────────────────────
  // The DAG. One sire, one dam, both nullable — biology's own constraint,
  // enforced by the schema rather than by application code.
  sireId String?
  damId  String?

  /// True for ancestor records created by a pedigree import that exist only
  /// as a name on someone else's papers. They still occupy real slots in the
  /// graph; they just have nobody maintaining them.
  isAncestorStub Boolean @default(false)

  /// Set when this record has been merged into another (invariant 4). The
  /// row survives so existing links keep resolving.
  supersededByDogId String?

  /// Self-reported free text. NEVER merged with verified data (invariant 4).
  temperamentNotes String? @db.Text
  ownerNotes       String? @db.Text

  /// Denormalised kennel of record. Ownership history is in DogOwnership.
  kennelId String?

  isDeceased  Boolean @default(false)
  isRetired   Boolean @default(false)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  kennel        Kennel?        @relation(fields: [kennelId], references: [id], onDelete: SetNull)
  registrations Registration[]
  ownerships    DogOwnership[]
  media         DogMedia[]

  // Ancestry self-relations. SetNull on delete so removing a dog leaves an
  // honest gap in its descendants' pedigrees rather than cascading them away.
  sire          Dog?  @relation("DogSire", fields: [sireId], references: [id], onDelete: SetNull)
  damRel        Dog?  @relation("DogDam", fields: [damId], references: [id], onDelete: SetNull)
  sireOffspring Dog[] @relation("DogSire")
  damOffspring  Dog[] @relation("DogDam")

  supersededBy Dog?  @relation("DogSupersededBy", fields: [supersededByDogId], references: [id], onDelete: SetNull)
  supersedes   Dog[] @relation("DogSupersededBy")

  pedigreeStats     DogPedigreeStats?
  pedigreeImports   PedigreeImport[]    @relation("PedigreeImportRoot")
  mergeCandidatesA  DogMergeCandidate[] @relation("MergeCandidateA")
  mergeCandidatesB  DogMergeCandidate[] @relation("MergeCandidateB")
  supersessionAsOld DogSupersession?    @relation("SupersededDog")
  supersessionAsNew DogSupersession[]   @relation("SurvivingDog")

  // Phase 2 — verification
  verifiedClaims      VerifiedClaim[]
  reportedClaims      ReportedClaim[]
  verificationChecks  VerificationCheck[]
  documentSubmissions DocumentSubmission[]
  verificationSummary DogVerificationSummary?

  // Phase 3 — breeder workspace
  heatCycles      HeatCycle[]
  breedingsAsSire Breeding[]      @relation("BreedingSire")
  breedingsAsDam  Breeding[]      @relation("BreedingDam")
  littersAsSire   Litter[]        @relation("LitterSire")
  littersAsDam    Litter[]        @relation("LitterDam")
  puppyRecord     Puppy?
  careTasks       CareTask[]
  feedRoutines    FeedRoutine[]
  vaultDocuments  VaultDocument[]

  // Phase 4 — stud directory
  studListing       StudListing?
  inquiriesAsDam    StudInquiry[]  @relation("InquiryDam")
  contractsAsSire   Contract[]     @relation("ContractSire")
  contractsAsDam    Contract[]     @relation("ContractDam")
  savedPairingsSire SavedPairing[] @relation("SavedPairingSire")
  savedPairingsDam  SavedPairing[] @relation("SavedPairingDam")

  @@index([breed, sex])
  @@index([kennelId])
  @@index([isPublished, breed])
  @@index([microchip])
  @@index([sireId])
  @@index([damId])
  @@index([registeredName])
  @@index([supersededByDogId])
  @@map("dogs")
}

enum RegistryBody {
  AKC
  UKC
  CKC // Canadian Kennel Club
  FCI
  KC // The Kennel Club (UK)
  NAVHDA
  AFTCA
  ABCA
  JRTCA
  CONTINENTAL
  OTHER
}

/// A dog's registration with a registry body. A dog may hold several.
model Registration {
  id           String       @id @default(cuid())
  dogId        String
  body         RegistryBody
  number       String
  /// Registered name as it appears on the papers — may differ from Dog.registeredName.
  nameOnRecord String?
  issuedAt     DateTime?

  isPrimary Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@unique([body, number])
  @@index([dogId])
  @@map("registrations")
}

/// Append-only ownership ledger. Transfers (Phase 8) close one row and open
/// the next; rows are never deleted.
model DogOwnership {
  id     String @id @default(cuid())
  dogId  String
  userId String

  /// Co-ownership is common and contractually significant.
  sharePercent Int       @default(100)
  startedAt    DateTime  @default(now())
  endedAt      DateTime?
  reason       String? // "purchase" | "transfer" | "co_ownership" | "initial"

  createdAt DateTime @default(now())

  dog  Dog  @relation(fields: [dogId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([dogId, endedAt])
  @@index([userId, endedAt])
  @@map("dog_ownerships")
}

enum MediaKind {
  PHOTO
  VIDEO
  DOCUMENT
}

model DogMedia {
  id              String    @id @default(cuid())
  dogId           String
  kind            MediaKind @default(PHOTO)
  url             String
  thumbUrl        String?
  caption         String?
  width           Int?
  height          Int?
  durationSeconds Int?
  position        Int       @default(0)
  isPrimary       Boolean   @default(false)

  takenAt   DateTime?
  createdAt DateTime  @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId, position])
  @@map("dog_media")
}

/// Every consequential mutation lands here. Auditable over impressive.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorType  String   @default("user") // "user" | "system" | "worker"
  action     String // "dog.create" | "verification.transition" | ...
  entityType String
  entityId   String
  before     Json?
  after      Json?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1 — Ancestry graph, pedigree import, duplicate resolution
// ═══════════════════════════════════════════════════════════════════════════

// Ancestry is modelled as self-relations on Dog, not an edge table.
//
// Biology gives every dog exactly one sire and one dam, so a pair of nullable
// self-references IS the proper DAG here — indexable, join-free, and
// impossible to represent inconsistently. An edge table would let a dog carry
// three sires. Cycles are rejected at write time (see @stud/pedigree's
// buildGraph and the API's assertNoCycle).

enum PedigreeSourceKind {
  MANUAL
  CSV
  REGISTRY_TEXT
  REGISTRY_API
  MERGE
}

/// Records how a dog's ancestry got here. Provenance matters as much for
/// pedigree as it does for health results — a hand-typed great-grandsire and
/// one pulled from a registry are not the same quality of fact.
model PedigreeImport {
  id        String  @id @default(cuid())
  kennelId  String?
  userId    String?
  rootDogId String?

  kind     PedigreeSourceKind
  /// Original pasted text or file name. Kept so an import can be re-run when
  /// the parser improves.
  rawInput String?            @db.Text
  fileName String?

  dogsCreated Int   @default(0)
  dogsLinked  Int   @default(0)
  dogsSkipped Int   @default(0)
  /// Parser warnings and errors, verbatim.
  issues      Json?

  createdAt DateTime @default(now())

  rootDog Dog?  @relation("PedigreeImportRoot", fields: [rootDogId], references: [id], onDelete: SetNull)
  user    User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([kennelId, createdAt])
  @@index([rootDogId])
  @@map("pedigree_imports")
}

enum MergeStatus {
  OPEN
  MERGED
  DISMISSED
}

/// A suspected duplicate pair, surfaced by @stud/pedigree's findDuplicates.
///
/// A duplicated ancestor silently LOWERS every COI it appears in — the two
/// copies read as unrelated dogs. This queue exists because that failure is
/// invisible unless something goes looking for it.
model DogMergeCandidate {
  id         String      @id @default(cuid())
  /// Ordered so (a,b) and (b,a) can never both exist.
  dogAId     String
  dogBId     String
  score      Float
  confidence String // "certain" | "likely" | "possible"
  reasons    String[]    @default([])
  conflicts  String[]    @default([])
  status     MergeStatus @default(OPEN)

  resolvedByUserId String?
  resolvedAt       DateTime?
  /// Which record survived, when status is MERGED.
  keptDogId        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dogA Dog @relation("MergeCandidateA", fields: [dogAId], references: [id], onDelete: Cascade)
  dogB Dog @relation("MergeCandidateB", fields: [dogBId], references: [id], onDelete: Cascade)

  @@unique([dogAId, dogBId])
  @@index([status, score])
  @@map("dog_merge_candidates")
}

/// Append-only supersession pointer (invariant 4). When two records merge,
/// the losing record is not deleted — it is marked as superseded so any link
/// anyone already holds still resolves.
model DogSupersession {
  id              String   @id @default(cuid())
  supersededDogId String   @unique
  survivingDogId  String
  reason          String   @default("merge")
  actorUserId     String?
  createdAt       DateTime @default(now())

  supersededDog Dog @relation("SupersededDog", fields: [supersededDogId], references: [id], onDelete: Cascade)
  survivingDog  Dog @relation("SurvivingDog", fields: [survivingDogId], references: [id], onDelete: Cascade)

  @@index([survivingDogId])
  @@map("dog_supersessions")
}

/// Cached COI so list views and search filters do not recompute a graph walk
/// per row. Always recomputed, never authored — a stale value here is a
/// correctness bug, so `computedAt` and `generations` are mandatory context.
model DogPedigreeStats {
  dogId                String   @id
  /// Wright's F over `generations`.
  coi                  Float
  generations          Int
  /// Maignel's complete generation equivalent.
  generationEquivalent Float
  completenessRatio    Float
  distinctAncestors    Int
  knownSlots           Int
  deepestGeneration    Int
  computedAt           DateTime @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([coi])
  @@index([computedAt])
  @@map("dog_pedigree_stats")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 2 — Verification engine
// ═══════════════════════════════════════════════════════════════════════════
//
// Invariant 5 is enforced structurally here: VerifiedClaim and ReportedClaim
// are SEPARATE TABLES. There is no column a self-attested value could occupy
// on a verified record, and no fallback path from one to the other. The only
// way into VerifiedClaim is a source lookup.

enum VerificationState {
  UNVERIFIED
  PENDING
  VERIFIED
  STALE
  CONFLICTED
}

enum VerificationSource {
  OFA
  AKC
  UKC
  CKC
  NAVHDA
  AFTCA
  PENNHIP
  EMBARK
  WISDOM
  UC_DAVIS
  PAW_PRINT
  DOCUMENT
  FIXTURE
}

enum ClaimOutcome {
  NORMAL
  CARRIER
  AT_RISK
  ABNORMAL
  INCONCLUSIVE
  INFORMATIONAL
}

enum ClaimCategory {
  HEALTH
  GENETIC
  TITLE
  REGISTRATION
  PERFORMANCE
}

/// A claim confirmed against the body that issued it.
///
/// Nothing writes here except the verification engine. `rawResult` is the
/// source's own wording, retained verbatim; `outcome` is our normalised
/// reading of it and exists only so buyers can filter comparably.
model VerifiedClaim {
  id    String @id @default(cuid())
  dogId String

  /// Matches @stud/verify's ClaimType. Kept as a string rather than an enum so
  /// a new breed panel does not require a migration.
  claimType  String
  category   ClaimCategory
  /// For DNA_MARKER: which gene or variant. Empty string, never NULL —
  /// Postgres treats NULLs as distinct in a unique index, so a nullable
  /// column here would silently permit duplicate claims for the same dog.
  markerName String        @default("")

  state   VerificationState  @default(UNVERIFIED)
  source  VerificationSource
  outcome ClaimOutcome?

  /// Verbatim, as the source phrases it. Never normalised in place.
  rawResult      String?
  /// The source's own identifier for this record.
  sourceRecordId String?
  sourceUrl      String?
  /// Anything the source published that does not fit the shape above.
  detail         String?

  /// When the test was performed or the title awarded.
  testedAt          DateTime?
  /// When a machine last successfully confirmed it.
  lastCheckedAt     DateTime?
  /// When it next falls out of the freshness window.
  staleAfter        DateTime?
  /// The identifier the lookup matched on.
  matchedIdentifier String?

  /// Populated only while CONFLICTED — what the source now says.
  conflictRawResult String?
  conflictOutcome   ClaimOutcome?
  conflictNote      String?       @db.Text
  conflictedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog    Dog                 @relation(fields: [dogId], references: [id], onDelete: Cascade)
  checks VerificationCheck[]
  events VerificationEvent[]

  /// One verified claim per dog per claim per marker per source.
  @@unique([dogId, claimType, markerName, source])
  @@index([dogId, state])
  @@index([state, staleAfter])
  @@index([claimType, outcome])
  @@map("verified_claims")
}

/// A claim the owner made about their own dog.
///
/// Deliberately a different table with a different shape. It has no `source`,
/// no `outcome` and no path to VERIFIED — the only way a claim becomes
/// verified is a fresh lookup that creates a VerifiedClaim of its own.
model ReportedClaim {
  id    String @id @default(cuid())
  dogId String

  claimType  String
  category   ClaimCategory
  /// Empty string, never NULL — see the note on VerifiedClaim.markerName.
  markerName String        @default("")

  /// Exactly what the owner typed. Never normalised, never graded.
  statedResult   String
  statedTestedAt DateTime?
  note           String?   @db.Text

  /// Who said it, so the claim is attributable.
  reportedByUserId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  dog        Dog   @relation(fields: [dogId], references: [id], onDelete: Cascade)
  reportedBy User? @relation(fields: [reportedByUserId], references: [id], onDelete: SetNull)

  @@unique([dogId, claimType, markerName])
  @@index([dogId])
  @@map("reported_claims")
}

enum LookupStatus {
  FOUND
  NOT_FOUND
  UNAVAILABLE
  DISABLED
  UNSUPPORTED_IDENTIFIER
}

/// Every lookup we ever ran, successful or not.
///
/// This is the receipt drawer. A verified badge without a check row behind it
/// is a bug, and an UNAVAILABLE row is as important as a FOUND one — it is the
/// evidence that we asked and could not get an answer.
model VerificationCheck {
  id      String  @id @default(cuid())
  dogId   String
  claimId String?

  source       VerificationSource
  identifier   String
  status       LookupStatus
  findingCount Int                @default(0)
  durationMs   Int
  error        String?            @db.Text
  /// Raw payload, so a parser fix can be replayed without re-querying.
  raw          Json?

  /// "user" | "system" | "worker"
  actorType   String  @default("user")
  actorUserId String?

  createdAt DateTime @default(now())

  dog   Dog            @relation(fields: [dogId], references: [id], onDelete: Cascade)
  claim VerifiedClaim? @relation(fields: [claimId], references: [id], onDelete: SetNull)

  @@index([dogId, createdAt])
  @@index([source, status, createdAt])
  @@map("verification_checks")
}

/// Every state transition, with the reason in the source's own words.
model VerificationEvent {
  id      String @id @default(cuid())
  claimId String

  fromState VerificationState
  toState   VerificationState
  trigger   String
  reason    String              @db.Text
  source    VerificationSource?

  previousRawResult String?
  observedRawResult String?

  actorType   String  @default("system")
  actorUserId String?

  createdAt DateTime @default(now())

  claim VerifiedClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)

  @@index([claimId, createdAt])
  @@map("verification_events")
}

enum DocumentReviewStatus {
  QUEUED
  IN_REVIEW
  APPROVED
  REJECTED
}

/// An uploaded certificate awaiting human review.
///
/// OCR pre-fills; a person confirms. Nothing here reaches VerifiedClaim until
/// `reviewedByUserId` is set — an OCR mis-read that turned "Carrier" into
/// "Clear" and auto-published would be the exact failure this platform exists
/// to prevent.
model DocumentSubmission {
  id    String @id @default(cuid())
  dogId String

  /// EMBARK | WISDOM | UC_DAVIS | PAW_PRINT | OTHER
  lab         String
  documentUrl String
  fileName    String?
  mimeType    String?
  fileSize    Int?

  status DocumentReviewStatus @default(QUEUED)

  /// What OCR proposed, with per-suggestion confidence and source lines.
  ocrText        String? @db.Text
  ocrSuggestions Json?

  /// What the reviewer confirmed. Only this becomes verified.
  reviewedFindings Json?
  reviewedByUserId String?
  reviewedAt       DateTime?
  rejectionReason  String?   @db.Text

  submittedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  dog         Dog   @relation(fields: [dogId], references: [id], onDelete: Cascade)
  reviewedBy  User? @relation("DocumentReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  submittedBy User? @relation("DocumentSubmitter", fields: [submittedByUserId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([dogId])
  @@map("document_submissions")
}

/// Denormalised verification density for a dog.
///
/// Drives the badge summary, marketplace filters and breeder tiering (Phase 9).
/// Recomputed, never authored.
model DogVerificationSummary {
  dogId String @id

  verifiedCount   Int @default(0)
  reportedCount   Int @default(0)
  unverifiedCount Int @default(0)
  staleCount      Int @default(0)
  conflictedCount Int @default(0)

  /// Verified health claims with a NORMAL outcome.
  healthNormalCount  Int     @default(0)
  /// Verified claims with an AT_RISK or ABNORMAL outcome. Never hidden.
  concerningCount    Int     @default(0)
  verifiedTitleCount Int     @default(0)
  hasChic            Boolean @default(false)

  /// verified ÷ (verified + reported + unverified). The tiering input.
  density Float @default(0)

  computedAt DateTime @default(now())

  dog Dog @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([density])
  @@index([healthNormalCount])
  @@map("dog_verification_summaries")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 3 — Breeder workspace
// ═══════════════════════════════════════════════════════════════════════════

/// A heat cycle. The first day of proestrus is the anchor everything else
/// hangs off, so it is required and everything else is optional.
model HeatCycle {
  id    String @id @default(cuid())
  dogId String

  /// First day of visible discharge. The one date that must be right.
  startedOn DateTime
  endedOn   DateTime?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog               Dog                @relation(fields: [dogId], references: [id], onDelete: Cascade)
  progesteroneTests ProgesteroneTest[]
  breedings         Breeding[]
  observations      HeatObservation[]

  @@index([dogId, startedOn])
  @@map("heat_cycles")
}

enum ProgesteroneUnit {
  NG_ML
  NMOL_L
}

/// A progesterone reading. Stored in the unit it was reported in — converting
/// on the way in would lose the lab's own number, which is the one a vet reads
/// back over the phone.
model ProgesteroneTest {
  id          String           @id @default(cuid())
  heatCycleId String
  takenOn     DateTime
  value       Float
  unit        ProgesteroneUnit @default(NG_ML)
  lab         String?
  notes       String?

  createdAt DateTime @default(now())

  heatCycle HeatCycle @relation(fields: [heatCycleId], references: [id], onDelete: Cascade)

  @@index([heatCycleId, takenOn])
  @@map("progesterone_tests")
}

/// Physical signs. Vulvar swelling, discharge colour, flagging, and the
/// temperature readings that precede whelping.
model HeatObservation {
  id          String   @id @default(cuid())
  heatCycleId String
  observedOn  DateTime

  /// "proestrus" | "estrus" | "diestrus"
  phase          String?
  dischargeColor String?
  swelling       String?
  receptive      Boolean?
  temperatureC   Float?
  notes          String?

  createdAt DateTime @default(now())

  heatCycle HeatCycle @relation(fields: [heatCycleId], references: [id], onDelete: Cascade)

  @@index([heatCycleId, observedOn])
  @@map("heat_observations")
}

enum BreedingMethod {
  NATURAL
  AI_FRESH
  AI_CHILLED
  AI_FROZEN
  AI_SURGICAL
  TCI
}

enum BreedingStatus {
  PLANNED
  BRED
  CONFIRMED_PREGNANT
  CONFIRMED_EMPTY
  WHELPED
  ABANDONED
}

/// A mating. Links a sire and a dam to a heat cycle and, eventually, a litter.
model Breeding {
  id          String  @id @default(cuid())
  kennelId    String?
  sireId      String
  damId       String
  heatCycleId String?

  method BreedingMethod
  status BreedingStatus @default(PLANNED)

  /// The timing anchor. Gestation is 63 days from ovulation and 58–68 from a
  /// breeding date — which is why this column exists and why the UI shows
  /// which one a forecast was built on.
  ovulationDate DateTime?
  lhSurgeDate   DateTime?

  /// Pregnancy confirmation.
  ultrasoundOn     DateTime?
  ultrasoundResult String?
  xrayOn           DateTime?
  xrayPuppyCount   Int?

  /// Collection and shipping paperwork for AI.
  collectionDate   DateTime?
  semenSource      String?
  shippingProvider String?
  shippingTracking String?

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sire        Dog                @relation("BreedingSire", fields: [sireId], references: [id], onDelete: Cascade)
  dam         Dog                @relation("BreedingDam", fields: [damId], references: [id], onDelete: Cascade)
  heatCycle   HeatCycle?         @relation(fields: [heatCycleId], references: [id], onDelete: SetNull)
  events      BreedingEvent[]
  litter      Litter?
  contracts   Contract[]
  collections CollectionRecord[]

  @@index([kennelId, status])
  @@index([damId, createdAt])
  @@index([sireId])
  @@map("breedings")
}

/// One tie or insemination. A breeding usually has two or three.
model BreedingEvent {
  id         String         @id @default(cuid())
  breedingId String
  occurredOn DateTime
  method     BreedingMethod
  /// Tie duration in minutes, for a natural breeding.
  tieMinutes Int?
  notes      String?

  createdAt DateTime @default(now())

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)

  @@index([breedingId, occurredOn])
  @@map("breeding_events")
}

enum LitterStatus {
  EXPECTED
  WHELPING
  ON_THE_GROUND
  WEANED
  PLACED
  ARCHIVED
}

/// A litter. Created when a breeding is confirmed and carried through to
/// placement — this is the record the marketplace listing composes itself from
/// in Phase 6.
model Litter {
  id         String  @id @default(cuid())
  breedingId String? @unique
  kennelId   String?
  sireId     String
  damId      String

  name   String?
  /// Letter naming, the way most programs track litters.
  letter String?

  status LitterStatus @default(EXPECTED)

  expectedWhelpOn DateTime?
  whelpedOn       DateTime?

  totalBorn      Int?
  liveBorn       Int?
  stillborn      Int?
  /// Deaths after a live birth. Recorded honestly — a litter's real history is
  /// worth more than a flattering one.
  neonatalDeaths Int  @default(0)

  whelpingNotes String? @db.Text
  notes         String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breeding       Breeding?       @relation(fields: [breedingId], references: [id], onDelete: SetNull)
  sire           Dog             @relation("LitterSire", fields: [sireId], references: [id], onDelete: Cascade)
  dam            Dog             @relation("LitterDam", fields: [damId], references: [id], onDelete: Cascade)
  puppies        Puppy[]
  whelpingEvents WhelpingEvent[]
  careTasks      CareTask[]
  listing        LitterListing?

  @@index([kennelId, status])
  @@index([damId])
  @@index([expectedWhelpOn])
  @@map("litters")
}

enum PuppyStatus {
  AVAILABLE
  RESERVED
  SOLD
  KEPT
  DECEASED
  STILLBORN
}

/// An individual puppy. Becomes a Dog record on placement (Phase 8), but
/// starts life here where the weights and the collar colour live.
model Puppy {
  id       String @id @default(cuid())
  litterId String

  /// Birth order matters clinically — the last out is often the one at risk.
  birthOrder  Int?
  name        String?
  /// What the breeder actually calls it before it is named: "green collar".
  collarColor String?
  sex         Sex
  status      PuppyStatus @default(AVAILABLE)

  birthWeightGrams Int?
  colorPattern     String?
  markings         String?
  microchip        String?

  bornAt       DateTime?
  diedAt       DateTime?
  causeOfDeath String?

  notes String? @db.Text

  // ── Phase 6: the public listing ──
  /// Overrides the litter's price range for this puppy. Integer cents.
  priceCents  Int?
  /// Shown to buyers. Kept separate from `notes`, which is the breeder's own
  /// working record and is never published.
  publicNotes String?  @db.Text
  photoUrls   String[] @default([])
  /// Hidden from the public page without changing the breeding record. A
  /// stillborn or deceased puppy stays in the litter's history either way —
  /// see `Litter.neonatalDeaths`.
  isPublic    Boolean  @default(true)

  /// Set once the puppy has its own Dog record.
  dogId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  litter    Litter          @relation(fields: [litterId], references: [id], onDelete: Cascade)
  dog       Dog?            @relation(fields: [dogId], references: [id], onDelete: SetNull)
  weights   PuppyWeight[]
  careTasks CareTask[]
  inquiries LitterInquiry[]

  @@index([litterId, birthOrder])
  @@index([status])
  @@map("puppies")
}

/// A weight. The single most useful number in a whelping box.
model PuppyWeight {
  id         String   @id @default(cuid())
  puppyId    String
  recordedOn DateTime
  grams      Int
  notes      String?

  createdAt DateTime @default(now())

  puppy Puppy @relation(fields: [puppyId], references: [id], onDelete: Cascade)

  @@index([puppyId, recordedOn])
  @@map("puppy_weights")
}

/// The live log during whelping. Written one-handed at 3am, so the schema is
/// deliberately forgiving — a timestamp and a note is a valid entry.
model WhelpingEvent {
  id         String   @id @default(cuid())
  litterId   String
  occurredAt DateTime @default(now())

  /// "contraction" | "puppy_born" | "placenta" | "rest" | "vet_called" | "note"
  kind    String
  puppyId String?
  note    String? @db.Text

  createdAt DateTime @default(now())

  litter Litter @relation(fields: [litterId], references: [id], onDelete: Cascade)

  @@index([litterId, occurredAt])
  @@map("whelping_events")
}

enum CareTaskStatus {
  PENDING
  DONE
  SKIPPED
}

/// A dated care task — vaccination, deworming, vet check, milestone.
///
/// Generated from the protocol in @stud/breeding, then editable. The generated
/// schedule is a starting point; the breeder's vet is the authority.
model CareTask {
  id       String  @id @default(cuid())
  litterId String?
  puppyId  String?
  dogId    String?

  kind   String
  title  String
  detail String? @db.Text

  dueOn             DateTime
  status            CareTaskStatus @default(PENDING)
  completedOn       DateTime?
  completedByUserId String?

  /// What was actually given, when it differs from the protocol.
  productUsed    String?
  dose           String?
  administeredBy String?
  notes          String? @db.Text

  /// True for tasks the protocol marks as blocking go-home.
  required Boolean @default(false)

  /// Idempotency key for generated tasks.
  ///
  /// A SINGLE non-null unique column rather than a compound key over nullable
  /// scope columns. Postgres treats NULLs as distinct inside a unique index,
  /// so `@@unique([litterId, puppyId, generatedKey])` would not have prevented
  /// duplicates for litter-scoped tasks at all — a breeder correcting a whelp
  /// date by one day would have ended up with two of every vaccination.
  ///
  /// Generated: "<scope>:<scopeId>:<protocolKey>". Manual: a random id.
  dedupeKey    String  @unique @default(cuid())
  /// The protocol key this came from, when it was generated.
  generatedKey String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  litter Litter? @relation(fields: [litterId], references: [id], onDelete: Cascade)
  puppy  Puppy?  @relation(fields: [puppyId], references: [id], onDelete: Cascade)
  dog    Dog?    @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dueOn, status])
  @@index([litterId, dueOn])
  @@index([dogId, dueOn])
  @@map("care_tasks")
}

/// Feeding and diet routine for a dog or a litter.
model FeedRoutine {
  id       String  @id @default(cuid())
  dogId    String?
  litterId String?

  label     String
  food      String
  amount    String?
  frequency String?
  notes     String? @db.Text

  startedOn DateTime?
  endedOn   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dog Dog? @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([dogId])
  @@index([litterId])
  @@map("feed_routines")
}

enum VaultDocumentKind {
  REGISTRATION_PAPER
  HEALTH_CERTIFICATE
  VET_RECORD
  PEDIGREE
  CONTRACT
  INSURANCE
  LICENCE
  OTHER
}

/// The document vault. Distinct from DocumentSubmission (Phase 2), which is a
/// verification queue — this is simply a filing cabinet.
model VaultDocument {
  id       String  @id @default(cuid())
  kennelId String?
  dogId    String?
  litterId String?
  puppyId  String?

  kind     VaultDocumentKind @default(OTHER)
  title    String
  url      String
  fileName String?
  mimeType String?
  fileSize Int?
  notes    String?

  issuedOn  DateTime?
  expiresOn DateTime?

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  dog Dog? @relation(fields: [dogId], references: [id], onDelete: Cascade)

  @@index([kennelId, kind])
  @@index([dogId])
  @@index([expiresOn])
  @@map("vault_documents")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 4 — Stud directory & match
// ═══════════════════════════════════════════════════════════════════════════

enum StudAvailability {
  AVAILABLE
  LIMITED
  BOOKED
  RETIRED
  NOT_LISTED
}

enum SemenType {
  NATURAL
  FRESH
  CHILLED
  FROZEN
}

/// A stud dog's public listing — his résumé, not a classified ad.
///
/// Almost nothing here is free text a seller controls: health, titles and
/// pedigree all come from the verified record. What lives on this model is
/// only the commercial terms, which are genuinely the owner's to state.
model StudListing {
  id    String @id @default(cuid())
  dogId String @unique

  availability StudAvailability @default(NOT_LISTED)

  /// Integer cents. Always. (Invariant 2.)
  studFeeCents Int?
  /// Some owners take a puppy instead of, or as well as, a fee.
  pickOfLitter Boolean @default(false)
  feeNotes     String?

  semenTypes        SemenType[] @default([])
  shipsSemen        Boolean     @default(false)
  /// How far the owner will travel, or expects the bitch to.
  travelRadiusMiles Int?
  willTravel        Boolean     @default(false)

  /// Owner-stated. Rendered as a Reported claim, never as verified.
  temperamentNotes String? @db.Text
  producedNotes    String? @db.Text
  requirements     String? @db.Text

  /// What the owner requires before agreeing to a breeding. This is the
  /// adverse-selection control — a stud owner sees who is asking before
  /// replying, and states up front what they expect.
  requiresHealthTesting Boolean @default(true)
  requiresContract      Boolean @default(true)
  requiresBrucellosis   Boolean @default(true)

  /// Denormalised for search. Recomputed, never authored.
  cachedVerifiedCount Int    @default(0)
  cachedCoi           Float?
  cachedDensity       Float  @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  dog       Dog           @relation(fields: [dogId], references: [id], onDelete: Cascade)
  inquiries StudInquiry[]

  @@index([availability, studFeeCents])
  @@index([publishedAt])
  @@map("stud_listings")
}

enum InquiryStatus {
  NEW
  READ
  REPLIED
  ACCEPTED
  DECLINED
  WITHDRAWN
}

/// A breeder asking about a stud.
///
/// Carries structured credentials rather than a bare message, so a stud owner
/// can triage on evidence instead of on how well someone writes. This is the
/// adverse-selection control the whole inquiry flow exists for.
model StudInquiry {
  id            String  @id @default(cuid())
  studListingId String
  /// The bitch being proposed. Optional — some inquiries are exploratory.
  damId         String?
  fromUserId    String
  fromKennelId  String?

  status  InquiryStatus @default(NEW)
  message String        @db.Text

  /// Snapshot of the pairing at the time of asking. Kept so a stud owner
  /// sees the numbers the breeder saw, even if the pedigree changes later.
  projectedCoi       Float?
  coiGenerations     Int?
  geneticRiskSummary String? @db.Text
  atRiskMarkerCount  Int     @default(0)
  damVerifiedCount   Int     @default(0)

  proposedSeason String?
  proposedMethod String?

  replyMessage String?   @db.Text
  repliedAt    DateTime?
  readAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studListing StudListing @relation(fields: [studListingId], references: [id], onDelete: Cascade)
  dam         Dog?        @relation("InquiryDam", fields: [damId], references: [id], onDelete: SetNull)
  fromUser    User        @relation(fields: [fromUserId], references: [id], onDelete: Cascade)

  @@index([studListingId, status, createdAt])
  @@index([fromUserId, createdAt])
  @@map("stud_inquiries")
}

/// A pairing a breeder saved to come back to.
///
/// Stores the computed numbers alongside the two dogs so a shortlist can be
/// sorted and compared without recomputing a graph walk per row — and so a
/// breeder can see what changed since they saved it.
model SavedPairing {
  id       String  @id @default(cuid())
  userId   String
  kennelId String?

  sireId String
  damId  String

  label String?
  notes String? @db.Text

  /// Snapshot at save time.
  projectedCoi      Float?
  coiGenerations    Int?
  coiBand           String?
  coiConfidence     String?
  atRiskMarkerCount Int     @default(0)
  sharedAncestors   Int     @default(0)

  computedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  sire Dog  @relation("SavedPairingSire", fields: [sireId], references: [id], onDelete: Cascade)
  dam  Dog  @relation("SavedPairingDam", fields: [damId], references: [id], onDelete: Cascade)

  @@unique([userId, sireId, damId])
  @@index([userId, createdAt])
  @@map("saved_pairings")
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 5 — Breeding transaction
// ═══════════════════════════════════════════════════════════════════════════

enum ContractStatus {
  DRAFT
  SENT
  PARTIALLY_SIGNED
  SIGNED
  VOIDED
  COMPLETED
}

enum ContractKind {
  STUD_SERVICE
  STUD_SERVICE_PICK_OF_LITTER
  CO_OWNERSHIP
  REPEAT_BREEDING_ONLY
  PUPPY_SALE
}

/// A contract between two parties.
///
/// The clause instances are the source of truth; `renderedText` and
/// `contentHash` are the frozen artefact a signature binds to. Once anyone has
/// signed, the clauses are immutable — an amendment is a new contract that
/// supersedes this one.
model Contract {
  id       String         @id @default(cuid())
  kennelId String?
  kind     ContractKind
  status   ContractStatus @default(DRAFT)

  title String

  /// Ordered ClauseInstance[] from @stud/contracts.
  clauses Json

  /// Frozen at send time. A signature binds to this hash, so editing the
  /// contract afterwards invalidates the signature rather than silently
  /// changing what somebody agreed to.
  renderedText String? @db.Text
  contentHash  String?

  /// The health schedule as it stood when the contract was drawn, so a later
  /// verification change cannot rewrite what the parties saw.
  healthSchedule Json?

  /// What this contract is about.
  breedingId String?
  sireId     String?
  damId      String?
  litterId   String?

  sentAt      DateTime?
  signedAt    DateTime?
  voidedAt    DateTime?
  voidReason  String?
  completedAt DateTime?

  /// Set when this contract replaces another (an amendment).
  supersedesContractId String?

  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  breeding     Breeding?             @relation(fields: [breedingId], references: [id], onDelete: SetNull)
  sire         Dog?                  @relation("ContractSire", fields: [sireId], references: [id], onDelete: SetNull)
  dam          Dog?                  @relation("ContractDam", fields: [damId], references: [id], onDelete: SetNull)
  parties      ContractParty[]
  signatures   ContractSignature[]
  schedule     PaymentSchedule?
  repeatClaims RepeatBreedingClaim[]

  @@index([kennelId, status])
  @@index([breedingId])
  @@index([status, createdAt])
  @@map("contracts")
}

enum PartyRole {
  STUD_OWNER
  BITCH_OWNER
  CO_OWNER
  BUYER
  SELLER
  WITNESS
}

model ContractParty {
  id         String    @id @default(cuid())
  contractId String
  userId     String
  role       PartyRole
  /// Snapshotted at invite time — the name in the document must not change
  /// because someone later edited their profile.
  legalName  String
  email      String
  /// False for a witness or observer.
  mustSign   Boolean   @default(true)

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([userId])
  @@map("contract_parties")
}

/// An electronic signature.
///
/// See packages/contracts/src/signature.ts for exactly what this is and is
/// not. In short: an auditable record of an authenticated party affirming
/// intent against a document whose content we can prove — not a
/// certificate-based digital signature.
model ContractSignature {
  id         String @id @default(cuid())
  contractId String
  userId     String

  /// Snapshotted identity at signing.
  legalName String
  email     String
  typedName String

  /// The exact consent wording shown and affirmed. Part of the record.
  consentText  String @db.Text
  /// Hash of the document as rendered when they signed it.
  documentHash String

  ipAddress String?
  userAgent String?
  signedAt  DateTime

  createdAt DateTime @default(now())

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([contractId, userId])
  @@index([contractId])
  @@map("contract_signatures")
}

enum InstalmentStatus {
  PENDING
  DUE
  PAID
  WAIVED
  REFUNDED
}

/// The payment plan for a contract. Integer cents throughout (invariant 2).
model PaymentSchedule {
  id         String @id @default(cuid())
  contractId String @unique

  totalCents     Int
  depositCents   Int     @default(0)
  /// From the contract's clause effects, never parsed from its prose.
  balanceTrigger String  @default("ON_CONFIRMED_PREGNANCY")
  /// From clause effects. Null when the contract is silent — in which case
  /// escrow refuses to decide and asks a human.
  noLitterRemedy String?

  currency String @default("USD")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract    Contract     @relation(fields: [contractId], references: [id], onDelete: Cascade)
  instalments Instalment[]
  escrow      EscrowHold?

  @@map("payment_schedules")
}

model Instalment {
  id         String @id @default(cuid())
  scheduleId String

  key         String
  label       String
  amountCents Int
  trigger     String
  status      InstalmentStatus @default(PENDING)

  dueSince DateTime?
  paidAt   DateTime?

  /// Provider reference, when one exists. Never a source of truth — the
  /// ledger is.
  providerChargeId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, key])
  @@index([status, dueSince])
  @@map("instalments")
}

enum EscrowStatus {
  EMPTY
  HOLDING
  PARTIALLY_RELEASED
  RELEASED
  REFUNDED
  DISPUTED
}

model EscrowHold {
  id         String @id @default(cuid())
  scheduleId String @unique

  status        EscrowStatus @default(EMPTY)
  heldCents     Int          @default(0)
  releasedCents Int          @default(0)
  refundedCents Int          @default(0)

  /// Who the money goes to on release, and back to on refund.
  payeeUserId String?
  payerUserId String?

  disputeOpenedAt DateTime?
  disputeReason   String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule PaymentSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("escrow_holds")
}

/// Double-entry, append-only. Never updated, never deleted.
///
/// A correction is a REVERSAL pair, exactly like a real ledger — because when
/// two parties disagree about who paid what, the answer has to be
/// reconstructible from an immutable record.
model LedgerEntry {
  id String @id @default(cuid())

  /// Groups the legs of one movement. Legs must sum to zero.
  transactionId String

  accountKind    String
  accountOwnerId String?

  /// Positive credits, negative debits. Integer cents.
  amountCents Int
  reason      String

  referenceType String
  referenceId   String
  memo          String?

  reversesTransactionId String?

  occurredAt DateTime
  createdAt  DateTime @default(now())

  @@index([transactionId])
  @@index([referenceType, referenceId])
  @@index([accountKind, accountOwnerId])
  @@map("ledger_entries")
}

enum RepeatClaimStatus {
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  DECLINED
  FULFILLED
}

/// A claim on a repeat-breeding right.
///
/// The right itself comes from the contract's clause effects. This record
/// tracks the claim through to the repeat service actually happening.
model RepeatBreedingClaim {
  id         String @id @default(cuid())
  contractId String

  status RepeatClaimStatus @default(SUBMITTED)

  /// What went wrong.
  reason         String  @db.Text
  vetConfirmed   Boolean @default(false)
  vetDocumentUrl String?

  /// The breeding that failed, and the one that replaced it.
  failedBreedingId String?
  repeatBreedingId String?

  reviewedByUserId String?
  reviewedAt       DateTime?
  reviewNote       String?   @db.Text

  submittedByUserId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  contract Contract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId, status])
  @@map("repeat_breeding_claims")
}

/// Collection and insemination paperwork for an AI breeding.
model CollectionRecord {
  id         String @id @default(cuid())
  breedingId String

  collectedOn DateTime
  collectedBy String?
  clinic      String?

  /// Semen evaluation, as reported by the collecting vet.
  volumeMl            Float?
  concentrationMkml   Float?
  motilityPercent     Int?
  morphologyPercent   Int?
  totalMotileMillions Float?

  shippedOn         DateTime?
  shippingCarrier   String?
  trackingNumber    String?
  receivedOn        DateTime?
  receivedCondition String?

  inseminatedOn DateTime?
  inseminatedBy String?
  method        String?

  documentUrl String?
  notes       String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  breeding Breeding @relation(fields: [breedingId], references: [id], onDelete: Cascade)

  @@index([breedingId, collectedOn])
  @@map("collection_records")
}

// ── Phase 6: litter & puppy marketplace ─────────────────────────────────────

enum LitterAvailability {
  /// Drafted but not public.
  NOT_LISTED
  /// Bred, not yet confirmed. Buyers can register interest.
  PLANNED
  /// Confirmed pregnant, puppies not yet on the ground.
  EXPECTING
  /// Whelped, puppies available.
  AVAILABLE
  /// Every puppy is spoken for, but the page stays up — it is the program's
  /// public record, and a sold-out litter is the best proof a breeder has.
  FULLY_RESERVED
  /// Placed and archived. Still indexed.
  PAST
}

/**
 * The public face of a litter.
 * Deliberately separate from `Litter`. A litter is a breeding record that
 * exists whether or not anyone is selling anything; a listing is a marketing
 * artefact with a price, a slug and a publication date. Merging them would
 * mean a breeder cannot record a litter without also publishing it.
 * Nothing here duplicates the record. Parent health, titles, COI and pedigree
 * are read live from the dogs at request time — the breeder does not retype a
 * single test result to publish (the phase gate).
 */
model LitterListing {
  id       String @id @default(cuid())
  litterId String @unique

  /// Stable public URL. Never regenerated once published — a changed slug is
  /// a lost search ranking.
  slug String @unique

  availability LitterAvailability @default(NOT_LISTED)

  /// Integer cents. Always. (Invariant 2.)
  priceCentsFrom Int?
  priceCentsTo   Int?
  depositCents   Int?
  /// Owner-stated context on price. Rendered as breeder-stated, never as fact.
  priceNotes     String? @db.Text

  headline          String?
  description       String? @db.Text
  /// What a buyer gets. Free text because every program differs.
  includedInPrice   String? @db.Text
  /// What the breeder expects of a buyer. The adverse-selection control, same
  /// idea as StudListing.requirements.
  buyerRequirements String? @db.Text

  /// Earliest the puppies can go home. Eight weeks is a floor in most states
  /// and a welfare minimum everywhere.
  goHomeFrom DateTime?

  /// URLs only. There is no upload pipeline yet, and pretending otherwise
  /// would put a broken file input in front of a breeder.
  photoUrls String[] @default([])

  /// Denormalised for search and ranking. Recomputed, never authored.
  cachedBreed         String?
  cachedRegion        String?
  cachedCountry       String  @default("US")
  cachedLatitude      Float?
  cachedLongitude     Float?
  cachedSireVerified  Int     @default(0)
  cachedDamVerified   Int     @default(0)
  cachedParentDensity Float   @default(0)
  cachedCoi           Float?
  cachedAvailablePups Int     @default(0)
  cachedTotalPups     Int     @default(0)

  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  litter    Litter          @relation(fields: [litterId], references: [id], onDelete: Cascade)
  inquiries LitterInquiry[]

  @@index([availability, publishedAt])
  @@index([cachedBreed, availability])
  @@index([cachedRegion, availability])
  @@index([publishedAt])
  @@map("litter_listings")
}

/**
 * A buyer asking about a litter.
 * Phase 6 keeps this deliberately thin — a message and enough context for the
 * breeder to reply. Phase 7 grows it into the application pipeline; making it
 * an application now would build the wrong thing twice.
 */
model LitterInquiry {
  id              String @id @default(cuid())
  litterListingId String

  /// Null for a signed-out enquiry. The email is what we actually need.
  fromUserId String?

  name    String
  email   String
  phone   String?
  message String  @db.Text

  status InquiryStatus @default(NEW)

  /// Which puppy they asked about, when they named one.
  puppyId String?

  /// Answers to the breeder's own questions, asked at enquiry time so the
  /// first reply is not four rounds of the same questions.
  householdNotes String?  @db.Text
  hasOtherDogs   Boolean?
  hasChildren    Boolean?
  homeType       String?

  replyMessage String?   @db.Text
  repliedAt    DateTime?
  readAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  litterListing LitterListing @relation(fields: [litterListingId], references: [id], onDelete: Cascade)
  fromUser      User?         @relation(fields: [fromUserId], references: [id], onDelete: SetNull)
  puppy         Puppy?        @relation(fields: [puppyId], references: [id], onDelete: SetNull)

  @@index([litterListingId, status, createdAt])
  @@index([email, createdAt])
  @@map("litter_inquiries")
}
